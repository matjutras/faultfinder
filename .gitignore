# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
*.pyc

# Generated per-device output (regenerate from KiCad source; see CLAUDE.md).
# circuit.cir is NOT ignored yet: until the importer exists (milestone 4+) it's
# hand-authored source, not generated output. Add it here once kicad-cli produces it.
devices/*/*.png
devices/*/*.glb
# map.json and faults.json ARE generated now: POST /api/devices/{id}/import
# (backend/app/kicad_import.py + backend/app/fault_gen.py) regenerates both from
# the device's .kicad_sch / circuit.cir. Regenerate after checkout instead of committing.
devices/*/map.json
devices/*/faults.json
# .kicad_pcb is ALSO generated now (milestone 5): the importer auto-places it
# from the schematic via backend/scripts/build_pcb.py -- it's not hand-authored
# board layout, so it's generated output like circuit.cir's siblings above.
devices/*/*.kicad_pcb
# kicad-cli/pcbnew auto-create these project-state files as a side effect of
# touching a .kicad_sch/.kicad_pcb with no project file yet -- not source.
devices/*/*.kicad_pro
devices/*/*.kicad_prl

# Real-world imported devices are the opposite of the rules just above: their
# .kicad_pcb (and .kicad_pro, when the source repo ships one) is the actual
# professionally-routed board from the source repo -- re-anchored to (0,0) by
# import_real_pcb.py, but otherwise untouched -- not something build_pcb.py
# auto-places from the schematic, so it's committed source, like the
# .kicad_sch. See each such device's NOTICE.md and CLAUDE.md's "Real-world
# imported devices" section. Un-ignored per device, not globally, so a
# *hand-authored* device's .kicad_pcb still defaults to generated/ignored.
# .kicad_prl stays ignored even for these -- pcbnew regenerates it as pure
# editor-state (active layer, opacity, selection filter) every time
# import_real_pcb.py loads/saves the board, so it's never real source here
# either.
!devices/bridge_rectifier_06/*.kicad_pcb
!devices/bridge_rectifier_06/*.kicad_pro

# Editors / OS
.vscode/
.DS_Store
